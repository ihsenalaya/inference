   "title": "Phases de démarrage d'un pod vLLM",
   "description": "Durées Kubernetes : planification, pull d'image, démarrage conteneur, ready. Mesurées par kube-state-metrics.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 7,
    "w": 24,
    "x": 0,
    "y": 13
   },
   "targets": [
    {
     "refId": "A",
     "expr": "kube_pod_status_ready_time{namespace=\"inference\"} - kube_pod_created{namespace=\"inference\"}",
