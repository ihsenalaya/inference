{
 "uid": "lab-capacity",
 "title": "03 - Capacité et coût",
 "description": "Débit maximal observé, coût horaire, coût par million de tokens, temps GPU inactif, délais de cold start.",
 "tags": [
  "lab"
 ],
 "schemaVersion": 39,
 "version": 1,
 "editable": true,
 "time": {
  "from": "now-1h",
  "to": "now"
 },
