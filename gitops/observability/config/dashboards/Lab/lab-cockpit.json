   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.5, sum by (le, model_name) (rate(vllm:e2e_request_latency_seconds_bucket{model_name=~\"$model\"}[$__rate_interval])))",
     "legendFormat": "p50 {{model_name}}",
