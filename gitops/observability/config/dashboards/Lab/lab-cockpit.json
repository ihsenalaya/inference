  {
   "id": 9,
   "type": "timeseries",
   "title": "Requêtes en cours / en attente",
   "description": "Running = batch courant ; waiting = file. Une file qui monte = capacité insuffisante : max-num-seqs, réplicas, KEDA.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 7,
    "w": 8,
    "x": 0,
    "y": 16
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (model_name) (vllm:num_requests_running{model_name=~\"$model\"})",
     "legendFormat": "running {{model_name}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    },
    {
     "refId": "B",
     "expr": "sum by (model_name) (vllm:num_requests_waiting{model_name=~\"$model\"})",
