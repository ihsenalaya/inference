     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "Taux d'erreur (LiteLLM)",
   "description": "Part des requêtes en échec vu de la passerelle. Levier : timeouts, OOM, saturation, fallback LiteLLM.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 7,
    "w": 8,
    "x": 0,
    "y": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "(sum(rate(litellm_proxy_failed_requests_metric_total[$__rate_interval])) or vector(0)) / sum(rate(litellm_proxy_total_requests_metric_total[$__rate_interval]))",
     "legendFormat": "erreurs",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "custom": {
      "fillOpacity": 8,
      "lineWidth": 1,
      "stacking": {
       "mode": "none"
      }
     }
    },
    "overrides": []
