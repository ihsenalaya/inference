{
 "uid": "lab-compare",
 "title": "04 - Comparaison de runs",
 "description": "Avant / après : les annotations de bench (profil, scénario, SHA Git, paramètres vLLM) délimitent chaque run.",
 "tags": [
  "lab"
 ],
 "schemaVersion": 39,
 "version": 1,
 "editable": true,
 "time": {
  "from": "now-1h",
  "to": "now"
 },
 "refresh": "30s",
 "timezone": "browser",
 "templating": {
  "list": [
   {
    "name": "model",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "query": {
     "query": "label_values(vllm:num_requests_running, model_name)",
     "refId": "m"
    },
    "refresh": 2,
    "includeAll": true,
    "allValue": ".*",
    "multi": true,
    "current": {
     "text": "All",
     "value": "$__all"
    }
   },
   {
    "name": "pod",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "query": {
     "query": "label_values(vllm:num_requests_running, pod)",
     "refId": "p"
    },
    "refresh": 2,
    "includeAll": true,
    "allValue": ".*",
    "multi": true,
    "current": {
     "text": "All",
     "value": "$__all"
    }
   },
   {
    "name": "namespace",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "query": {
     "query": "label_values(vllm:num_requests_running, namespace)",
     "refId": "n"
    },
    "refresh": 2,
    "includeAll": true,
    "allValue": ".*",
    "multi": true,
    "current": {
     "text": "All",
     "value": "$__all"
    }
   }
  ]
 },
 "panels": [
  {
   "id": 1,
   "type": "row",
   "title": "Comparer deux plages de temps",
   "collapsed": false,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 0
   },
   "panels": []
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "TTFT p95",
   "description": "Sélectionner deux plages via les annotations de bench.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 7,
    "w": 12,
    "x": 0,
    "y": 1
   },
   "targets": [
    {
     "refId": "A",
     "expr": "lab:ttft_seconds:p95",
     "legendFormat": "{{model_name}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "custom": {
      "fillOpacity": 8,
      "lineWidth": 1,
      "stacking": {
       "mode": "none"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "Tokens/s",
   "description": "Débit.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 7,
    "w": 12,
    "x": 12,
    "y": 1
   },
   "targets": [
    {
     "refId": "A",
     "expr": "lab:generation_tokens:rate1m",
     "legendFormat": "{{model_name}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "fillOpacity": 8,
      "lineWidth": 1,
      "stacking": {
       "mode": "none"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "id": 4,
   "type": "timeseries",
   "title": "Inter-token p95",
   "description": "Latence de décodage.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 7,
    "w": 12,
    "x": 0,
    "y": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "lab:itl_seconds:p95",
     "legendFormat": "{{model_name}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "custom": {
      "fillOpacity": 8,
      "lineWidth": 1,
      "stacking": {
       "mode": "none"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "Coût par million de tokens",
   "description": "Efficacité économique.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 7,
    "w": 12,
    "x": 12,
    "y": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "lab:cost_per_million_tokens_usd",
     "legendFormat": "$ / M",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "currencyUSD",
     "custom": {
      "fillOpacity": 8,
      "lineWidth": 1,
      "stacking": {
       "mode": "none"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "Cache de préfixes",
   "description": "Hit ratio.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 7,
    "w": 12,
    "x": 0,
    "y": 15
   },
   "targets": [
    {
     "refId": "A",
     "expr": "lab:prefix_cache_hit_ratio",
     "legendFormat": "{{model_name}}",
     "datasource": {
      "type": "prometheus",
