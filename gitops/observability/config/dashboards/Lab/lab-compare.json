      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "id": 7,
   "type": "timeseries",
   "title": "Charge par pod",
   "description": "Équilibre du routage.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 7,
    "w": 12,
    "x": 12,
    "y": 15
   },
   "targets": [
    {
     "refId": "A",
     "expr": "lab:replica_load_gap",
     "legendFormat": "{{model_name}}",
     "datasource": {
