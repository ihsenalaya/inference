    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "id": 4,
   "type": "row",
   "title": "Mémoire",
   "collapsed": false,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 8
   },
   "panels": []
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "Mémoire utilisée / libre",
   "description": "Framebuffer du GPU (16 Go sur T4).",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 7,
    "w": 12,
    "x": 0,
    "y": 9
   },
   "targets": [
    {
     "refId": "A",
     "expr": "DCGM_FI_DEV_FB_USED * 1024 * 1024",
     "legendFormat": "utilisée {{gpu}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    },
    {
     "refId": "B",
     "expr": "DCGM_FI_DEV_FB_FREE * 1024 * 1024",
     "legendFormat": "libre {{gpu}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "bytes",
     "custom": {
      "fillOpacity": 15,
      "lineWidth": 1,
      "stacking": {
       "mode": "normal"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "Mémoire par pod",
   "description": "Jointure DCGM / pod (honorLabels) : qui consomme la mémoire.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 7,
    "w": 12,
    "x": 12,
    "y": 9
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (pod) (DCGM_FI_DEV_FB_USED) * 1024 * 1024",
     "legendFormat": "{{pod}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "bytes",
