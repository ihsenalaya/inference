{
 "uid": "lab-gpu",
 "title": "02 - GPU en profondeur",
 "description": "Par GPU, nœud et pod : utilisation face à l'activité moteur, mémoire, énergie, erreurs, PCIe.",
 "tags": [
  "lab"
 ],
 "schemaVersion": 39,
 "version": 1,
 "editable": true,
 "time": {
  "from": "now-1h",
  "to": "now"
 },
 "refresh": "30s",
 "timezone": "browser",
 "templating": {
  "list": []
 },
 "panels": [
  {
   "id": 1,
   "type": "row",
   "title": "Charge",
   "collapsed": false,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 0
   },
   "panels": []
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "Utilisation vs activité du moteur graphique",
   "description": "GPU_UTIL dit « un noyau tourne » ; PROF_GR_ENGINE_ACTIVE dit « le moteur est réellement occupé ». Un grand écart = noyaux peu efficaces.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 7,
    "w": 12,
    "x": 0,
    "y": 1
   },
   "targets": [
    {
     "refId": "A",
     "expr": "DCGM_FI_DEV_GPU_UTIL / 100",
     "legendFormat": "GPU_UTIL {{gpu}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    },
    {
     "refId": "B",
     "expr": "DCGM_FI_PROF_GR_ENGINE_ACTIVE",
     "legendFormat": "ENGINE_ACTIVE {{gpu}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "custom": {
      "fillOpacity": 8,
      "lineWidth": 1,
      "stacking": {
       "mode": "none"
      }
     },
     "min": 0,
     "max": 1
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "Activité DRAM (bande passante mémoire)",
   "description": "Le decode est limité par la bande passante mémoire : proche de 1 = on a atteint la limite du T4 (320 Go/s).",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 7,
    "w": 12,
    "x": 12,
    "y": 1
   },
   "targets": [
    {
     "refId": "A",
     "expr": "DCGM_FI_PROF_DRAM_ACTIVE",
     "legendFormat": "DRAM {{gpu}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "custom": {
      "fillOpacity": 8,
      "lineWidth": 1,
      "stacking": {
       "mode": "none"
      }
     },
     "min": 0,
     "max": 1
