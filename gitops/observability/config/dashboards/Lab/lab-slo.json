  {
   "id": 7,
   "type": "stat",
   "title": "interactive : budget consommé (disponibilité)",
   "description": "Moyenne des parts de requêtes en échec sur la période affichée / budget d'erreur (approximation : moyenne de ratios 5 min, non pondérée par le trafic). 100 % = budget épuisé.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 4,
    "w": 6,
    "x": 0,
    "y": 16
   },
   "targets": [
    {
     "refId": "A",
     "expr": "avg_over_time(slo:error_ratio:rate5m{class=\"interactive\",sli=\"availability\"}[$__range]) / scalar(slo:error_budget{class=\"interactive\",sli=\"availability\"})",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 0.5
       },
       {
        "color": "red",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value"
   }
  },
