    "h": 1,
    "w": 24,
    "x": 0,
    "y": 0
   },
   "panels": []
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "Burn rate sur 1 h",
   "description": "Part de requêtes mauvaises / budget d'erreur, fenêtre 1 h. Au-dessus de 14,4 (et 5 min confirmé) : page.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
